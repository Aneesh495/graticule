{
  "name": "graticule",
  "version": "1.0.0",
  "description": "A declarative compile-time cartographic projection, geospatial symbolizer, and analytical vector information graphics engine in pure Sass.",
  "main": "dist/graticule.css",
  "bin": {
    "graticule": "bin/graticule"
  },
  "scripts": {
    "build": "sass scss/graticule.scss dist/graticule.css --style=expanded --no-source-map",
    "build:min": "sass scss/graticule.scss dist/graticule.min.css --style=compressed --no-source-map",
    "build:showroom": "sass showroom/showroom.scss showroom/styles.css --style=compressed --no-source-map",
    "build:all": "npm run build && npm run build:min && npm run build:showroom",
    "serve": "node bin/graticule serve",
    "lint:dashes": "python3 scripts/lint_no_em_dashes.py",
    "test": "node test/run_all_tests.js",
    "test:sass": "sass test/test_runner.scss --no-source-map",
    "benchmark": "python3 scripts/benchmark_compiler.py",
    "verify": "bash scripts/verify_all.sh"
  },
  "keywords": [
    "cartography",
    "map-projections",
    "computational-geometry",
    "vector-graphics",
    "sass",
    "scss",
    "dataviz",
    "geospatial"
  ],
  "author": "Aneesh Krishna Parthasarathy",
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.83.0"
  }
}
